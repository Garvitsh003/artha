# Local development works without these: a private key is generated in data/.
APP_ENV=development
SECRET_KEY=
SETUP_TOKEN=
COOKIE_SECURE=0
DATA_DIR=./data
SQLITE_JOURNAL_MODE=DELETE
# Keep DELETE on PythonAnywhere. WAL is optional only on a local filesystem.
# On your production server set APP_ENV=production, COOKIE_SECURE=1,
# a random SECRET_KEY (32+ characters), and SETUP_TOKEN (20+ characters).
# Optional comma-separated hostnames, without scheme or port:
# TRUSTED_HOSTS=finance.example.com
